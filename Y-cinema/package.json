{
  "name": "y-cinema",
  "version": "1.0.0",
  "description": "Y-CINEMA — Free movies, series and anime streaming desktop app",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:scraper": "npm --prefix scraper-api run dev",
    "dev:electron:build": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "concurrently \"npm run dev:scraper\" \"vite\" \"npm run dev:electron:build\" \"wait-on tcp:5173 dist-electron/electron/main.js && electron .\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && npm --prefix scraper-api run build",
    "dist": "electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@movie-web/providers": "^2.4.13",
    "@supabase/supabase-js": "^2.45.4",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^17.4.2",
    "electron-store": "^8.2.0",
    "fast-xml-parser": "^4.5.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "webtorrent": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^31.7.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.y-cinema.desktop",
    "productName": "Y-CINEMA",
    "icon": "public/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scraper-api/dist",
        "to": "scraper-api/dist"
      },
      {
        "from": "scraper-api/node_modules",
        "to": "scraper-api/node_modules"
      },
      {
        "from": "scraper-api/package.json",
        "to": "scraper-api/package.json"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "ffprobe-static@3.1.0": true
  }
}
