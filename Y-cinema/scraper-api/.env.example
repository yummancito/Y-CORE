# Copiar a .env y completar. Sin esto, el servidor sigue funcionando con
# los demás scrapers (YTS, DonTorrent, Gnula, Cuevana, TPB, 1337x) — Jackett
# simplemente queda deshabilitado.

# Puerto donde corre Jackett (por defecto 9117, no suele cambiar)
JACKETT_URL=http://127.0.0.1:9117

# API Key de Jackett: se ve arriba a la derecha en http://127.0.0.1:9117
# después de instalarlo. Cambia solo si reinstalas Jackett.
JACKETT_API_KEY=

# Secreto compartido entre este servidor y el cliente Electron
# (electron/modules/scraper-client.ts, mismo valor en el .env raíz de la app).
# Sin esto, el servidor arranca igual pero cualquier proceso local puede
# llamar a sus endpoints sin autenticar — poné cualquier string aleatorio largo.
SCRAPER_INTERNAL_KEY=
