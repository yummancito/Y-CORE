NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Connection pooler de Supabase (Project Settings → Database → Connection
# pooling, modo "transaction", puerto 6543) — no la conexión directa 5432.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKeyDev

# Autenticación delegada a Supabase Auth (Project Settings → API). Ver
# prisma/supabase/auth-hook.sql para el setup de sincronización de
# usuarios y el custom claim "role" que estos valores hacen posible.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
SUPABASE_JWT_SECRET=change-me-to-the-project-jwt-secret

# Límites por ventana (RATE_LIMIT_WINDOW_MS). Anónimo = sin JWT,
# autenticado = usuario normal, admin = rol ADMIN (para no saturar sus
# propias colas de jobs con el límite genérico).
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# '*' solo es válido en development — en NODE_ENV=production el boot
# falla si sigue en '*'. Para producción: lista separada por comas de
# orígenes exactos, ej. https://tuapp.com,https://admin.tuapp.com
CORS_ORIGIN=*

# Oculta Swagger UI (/docs) salvo que se ponga explícitamente en true —
# en un servidor público expone toda la superficie de la API, incluida
# /admin/*.
EXPOSE_DOCS=false

# Opcionales — si faltan, esos providers quedan deshabilitados
TMDB_API_KEY=
OMDB_API_KEY=
FANART_API_KEY=
