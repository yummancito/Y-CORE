{"nodes": [{"id": "changelog_2_6_0_release", "label": "Y-CORE v2.6.0 Release Notes", "file_type": "document", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_2_6_0_discord_rich_presence", "label": "Discord Rich Presence Integration", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shows 'Jugando Y-core' / 'Jugando [Juego]' in Discord, updates automatically via a watcher when games open/close; covers art via Steam CDN without pre-loading images; implemented as a native named-pipe protocol integration without an npm dependency."}, {"id": "changelog_2_6_0_ycore_dll_native_component", "label": "ycore.dll Native C++ Component", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compiled C++17 DLL for ~3x faster Steam detection and an optimized VDF/ACF parser; zero external deps (Win32 + static CRT, no VC++ redistributable needed); source is intentionally NOT distributed, only the compiled DLL ships, to protect proprietary detection logic."}, {"id": "changelog_2_6_0_koffi_ffi_bridge", "label": "koffi FFI Bridge (Node <-> ycore.dll)", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses a disposable pattern to avoid memory leaks when calling into ycore.dll; lazy-loads the DLL and silently degrades the app to pure JS if it is missing, trading a hard failure for graceful degradation."}, {"id": "changelog_2_6_0_improved_error_dialog", "label": "Improved Error Dialog", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately hides raw stack traces from end users (folded 'technical details' section) with Retry/Report(Discord webhook)/Close actions, favoring human-readable messaging over developer-facing dumps."}, {"id": "changelog_2_6_0_bugs_fixed_session_7_8", "label": "12 Bugs Fixed (dev sessions 7-8)", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Batch of fixes: fetch timeouts (AbortController 30s/5min) in y-core-api.ts and depotbox.ts, infinite loop in useLibraryStore from orphan resolution re-scans, unguarded array access in LibraryPage infinite scroll, off-screen context menu, onlinefix.ts (Thunderstore) download timeout, hardcoded dumpbin path, unvalidated mod downloads (PK magic-byte check added), invisible low-opacity UI defaults, AppShell promise-chain indentation and setInterval dependency leak."}, {"id": "changelog_2_6_0_api_prod_fix", "label": "Store API pointed to production Render endpoint", "file_type": "rationale", "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Store previously loaded from a stale localhost .env value; fixed to point at https://y-core-render-api-rxwd.onrender.com so all 597 games load from production."}], "edges": [{"source": "changelog_2_6_0_release", "target": "changelog_2_6_0_discord_rich_presence", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "weight": 1.0}, {"source": "changelog_2_6_0_release", "target": "changelog_2_6_0_ycore_dll_native_component", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "CHANGELOG-2.6.0.md", "source_location": null, "weight": 1.0}, {"source": "changelog_2_6_0_release", "t