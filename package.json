{
  "name": "y-core",
  "version": "4.3.14",
  "description": "Y-core - Steam game management tool",
  "main": "dist-electron/main.js",
  "author": "Y-core",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "catalog": "node scripts/sync-catalog.mjs && node rebuild-catalog.js",
    "prebuild": "node scripts/sync-catalog.mjs && node rebuild-catalog.js && pnpm check:acf-contract",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "clean": "node -e \"require('fs-extra').removeSync('dist'); require('fs-extra').removeSync('dist-electron'); try { require('fs-extra').emptyDirSync('release') } catch {}\"",
    "predist": "node -e \"try { require('fs-extra').emptyDirSync('release') } catch {}\" && pnpm build:native",
    "dist": "electron-builder && node scripts/cleanup-dist.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "electron:dev": "concurrently -n vite,electron -c green,magenta \"vite\" \"ping localhost -n 15 > nul && electron .\"",
    "electron:dev:local": "concurrently -n api,vite,electron -c blue,green,magenta \"pnpm --filter @y-core/api dev\" \"vite\" \"wait-on tcp:5174 && wait-on tcp:3000 && electron .\"",
    "electron:build": "node scripts/sync-catalog.mjs && node rebuild-catalog.js && tsc && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dll": "npx tsx tests/dll-smoke-test.ts",
    "verify:dll-update": "node scripts/verify-dll-update.mjs",
    "check:acf-contract": "tsx scripts/check-acf-contract.ts",
    "build:native": "node scripts/build-or-download-dll.mjs",
    "build:full": "npm run build:native && npm run build && npm run dist",
    "build:cli": "tsc --strict --module commonjs --moduleResolution node --target ES2019 --esModuleInterop --skipLibCheck --rootDir . --outDir bin/compiled bin/ycore.ts electron/modules/electron-context.ts electron/modules/steamcmd-manager.ts electron/modules/steamcmd-types.ts electron/modules/steamcmd-parser.ts electron/modules/steamcmd-fetcher.ts electron/logger.ts",
    "prepublishOnly": "pnpm build:cli",
    "audit:vtables": "tsx scripts/audit-vtables.ts",
    "build:clean-room": "node scripts/build-or-download-dll.mjs"
  },
  "bin": {
    "ycore": "./bin/ycore.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "cross-zip": "^4.0.1",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "fs-extra": "^11.3.6",
    "fuse.js": "^7.4.2",
    "koffi": "^3.1.1",
    "lucide-react": "^0.400.0",
    "node-fetch": "^2.7.0",
    "png-to-ico": "^3.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "7zip-min": "^3.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.38",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  },
  "pnpm": {
    "allowBuild": [
      "electron",
      "esbuild",
      "msgpackr-extract"
    ]
  },
  "build": {
    "appId": "com.ycore.desktop",
    "productName": "Y-core",
    "icon": "public/logo.ico",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "native/**/*",
      "tools/**/*",
      "build/**/*",
      "public/logo.ico",
      "public/logo.svg",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.bin",
      "!node_modules/**/*.{md,markdown,map,ts}",
      "!node_modules/**/{test,tests,__tests__,example,examples,.github,.vscode}/**",
      "!**/*.d.ts"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dll",
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**",
      "**/node_modules/7zip-bin/**",
      "electron/dll/**",
      "native/opensteamtool/**"
    ],
    "extraResources": [
      {
        "from": "resources/native",
        "to": "native"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "certificateFile": null,
      "certificatePassword": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "installerHeaderIcon": "public/logo.ico"
    },
    "afterPack": "scripts/fix-exe.js",
    "publish": {
      "provider": "github",
      "owner": "yummancito",
      "repo": "Y-CORE"
    }
  }
}
