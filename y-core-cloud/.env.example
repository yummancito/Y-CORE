# ── Server ──
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Database ──
DATABASE_URL=postgresql://ycore:ycore_dev_password@localhost:5432/ycore_cloud

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── Rate Limiting ──
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20

# ── CORS ──
CORS_ORIGIN=*

# ── Heartbeat ──
HEARTBEAT_TIMEOUT_SECONDS=90

# ── Security ──
# HTTPS enforcement (production only)
ENABLE_HTTPS=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# JWT Secret - Use a strong random string (minimum 32 characters for HS256)
# If not set, a random secret will be generated but won't persist across restarts
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JWT_SECRET=your-secure-32-char-minimum-random-secret-here
